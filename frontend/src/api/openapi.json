{
  "openapi": "3.1.0",
  "info": {
    "title": "Plaza",
    "version": "0.1.0"
  },
  "paths": {
    "/api/meta": {
      "get": {
        "summary": "Get Meta",
        "operationId": "getMeta",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves": {
      "get": {
        "summary": "List Saves",
        "operationId": "listSaves",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SaveOut"
                  },
                  "type": "array",
                  "title": "Response Listsaves"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "New Game",
        "operationId": "newGame",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewGameIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{slug}/state": {
      "get": {
        "summary": "Get State",
        "operationId": "getState",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{slug}/advance": {
      "post": {
        "summary": "Advance",
        "operationId": "advance",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StateOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/saves/{slug}/explain/{kpi}": {
      "get": {
        "summary": "Explain",
        "description": "The breakdown of a cash KPI: every posted line on its account.",
        "operationId": "explainKpi",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Slug"
            }
          },
          {
            "name": "kpi",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Kpi"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainOut"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/llm": {
      "get": {
        "summary": "Get Llm",
        "operationId": "getLlmSettings",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmSettingsOut"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Put Llm",
        "operationId": "putLlmSettings",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmSettingsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmSettingsOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ExplainLineOut": {
        "properties": {
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "book": {
            "type": "string",
            "title": "Book"
          },
          "memo": {
            "type": "string",
            "title": "Memo"
          },
          "amount_cents": {
            "type": "integer",
            "title": "Amount Cents"
          }
        },
        "type": "object",
        "required": [
          "turn",
          "date_label",
          "book",
          "memo",
          "amount_cents"
        ],
        "title": "ExplainLineOut"
      },
      "ExplainOut": {
        "properties": {
          "kpi": {
            "type": "string",
            "title": "Kpi"
          },
          "account": {
            "type": "string",
            "title": "Account"
          },
          "total_cents": {
            "type": "integer",
            "title": "Total Cents"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ExplainLineOut"
            },
            "type": "array",
            "title": "Lines"
          }
        },
        "type": "object",
        "required": [
          "kpi",
          "account",
          "total_cents",
          "lines"
        ],
        "title": "ExplainOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LlmSettingsIn": {
        "properties": {
          "adapter": {
            "type": "string",
            "enum": [
              "claude",
              "templates"
            ],
            "title": "Adapter"
          },
          "monthly_budget_cents": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Monthly Budget Cents"
          }
        },
        "type": "object",
        "required": [
          "adapter",
          "monthly_budget_cents"
        ],
        "title": "LlmSettingsIn"
      },
      "LlmSettingsOut": {
        "properties": {
          "adapter": {
            "type": "string",
            "enum": [
              "claude",
              "templates",
              "mock"
            ],
            "title": "Adapter"
          },
          "has_key": {
            "type": "boolean",
            "title": "Has Key"
          },
          "monthly_budget_cents": {
            "type": "integer",
            "title": "Monthly Budget Cents"
          },
          "spent_cents": {
            "type": "number",
            "title": "Spent Cents"
          },
          "calls": {
            "type": "integer",
            "title": "Calls"
          },
          "resets_on": {
            "type": "string",
            "title": "Resets On"
          }
        },
        "type": "object",
        "required": [
          "adapter",
          "has_key",
          "monthly_budget_cents",
          "spent_cents",
          "calls",
          "resets_on"
        ],
        "title": "LlmSettingsOut"
      },
      "MetaOut": {
        "properties": {
          "scenarios": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Scenarios"
          },
          "difficulties": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Difficulties"
          },
          "backgrounds": {
            "items": {
              "$ref": "#/components/schemas/OptionOut"
            },
            "type": "array",
            "title": "Backgrounds"
          },
          "default_scenario": {
            "type": "string",
            "title": "Default Scenario"
          },
          "default_difficulty": {
            "type": "string",
            "title": "Default Difficulty"
          }
        },
        "type": "object",
        "required": [
          "scenarios",
          "difficulties",
          "backgrounds",
          "default_scenario",
          "default_difficulty"
        ],
        "title": "MetaOut"
      },
      "NewGameIn": {
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 63,
            "minLength": 1,
            "title": "Slug"
          },
          "org_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Org Name"
          },
          "leader_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Leader Name"
          },
          "background": {
            "type": "string",
            "title": "Background"
          },
          "difficulty": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Difficulty"
          },
          "scenario_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "ironman": {
            "type": "boolean",
            "title": "Ironman",
            "default": false
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1.8446744073709552e+19,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "org_name",
          "leader_name",
          "background"
        ],
        "title": "NewGameIn"
      },
      "OptionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "title": "OptionOut"
      },
      "SaveOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "leader_name": {
            "type": "string",
            "title": "Leader Name"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "name",
          "org_name",
          "leader_name",
          "turn",
          "date_label",
          "status"
        ],
        "title": "SaveOut"
      },
      "StateOut": {
        "properties": {
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "org_name": {
            "type": "string",
            "title": "Org Name"
          },
          "leader_name": {
            "type": "string",
            "title": "Leader Name"
          },
          "background": {
            "type": "string",
            "title": "Background"
          },
          "difficulty": {
            "type": "string",
            "title": "Difficulty"
          },
          "ironman": {
            "type": "boolean",
            "title": "Ironman"
          },
          "turn": {
            "type": "integer",
            "title": "Turn"
          },
          "date_label": {
            "type": "string",
            "title": "Date Label"
          },
          "last_turn": {
            "type": "integer",
            "title": "Last Turn"
          },
          "last_date_label": {
            "type": "string",
            "title": "Last Date Label"
          },
          "dirty_cash_cents": {
            "type": "integer",
            "title": "Dirty Cash Cents"
          },
          "clean_cash_cents": {
            "type": "integer",
            "title": "Clean Cash Cents"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "campaign_complete"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "slug",
          "org_name",
          "leader_name",
          "background",
          "difficulty",
          "ironman",
          "turn",
          "date_label",
          "last_turn",
          "last_date_label",
          "dirty_cash_cents",
          "clean_cash_cents",
          "status"
        ],
        "title": "StateOut"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
